+fn render_inbox_row(
+    buffer: &mut Buffer,
+    rect: Rect,
+    row: &AgentRow,
+    config: &ClientShellConfig,
+) -> Option<Rect> {
+    use crate::ui::{ResolvedToken, ResolvedTokenKind};
+    let palette = &config.palette;
+    let color = inbox_status_color(row.status, palette);
+    let mut rect = rect;
+    if let Some((label, count)) = row.section {
+        if rect.height == 0 {
+            return None;
+        }
+        let width = rect.width.saturating_sub(3);
+        put_text(
+            buffer,
+            rect.x + 2,
+            rect.y,
+            width,
+            label,
+            Style::default().fg(color).add_modifier(Modifier::BOLD),
+        );
+        let label_width = display_width(label) as u16;
+        if width > label_width + 2 {
+            put_text(
+                buffer,
+                rect.x + 3 + label_width,
+                rect.y,
+                width - label_width - 1,
+                &count.to_string(),
+                Style::default().fg(palette.overlay0),
+            );
+        }
+        rect = Rect::new(
+            rect.x,
+            rect.y + 1,
+            rect.width,
+            rect.height.saturating_sub(1),
+        );
+    }
+    let background = if row.focused {
+        Style::default().bg(palette.active_row_bg)
+    } else {
+        Style::default()
+    };
+    let text_at = |tokens: &[ResolvedToken], index: usize| -> String {
+        tokens
+            .get(index)
+            .map(|token| match &token.kind {
+                ResolvedTokenKind::Workspace(value)
+                | ResolvedTokenKind::TerminalTitle(value)
+                | ResolvedTokenKind::Custom(value) => value.clone(),
+                _ => String::new(),
+            })
+            .unwrap_or_default()
+    };
+    let mut archive = None;
+    for (index, tokens) in row.rows.iter().take(rect.height as usize).enumerate() {
+        let line = Rect::new(rect.x, rect.y + index as u16, rect.width, 1);
+        if tokens.is_empty() {
+            // The gap line between threads stays unpainted.
+            continue;
+        }
+        buffer.set_style(line, background);
+        put_text(buffer, line.x, line.y, 1, "▎", background.fg(color));
+        let x = line.x + 2;
