+                    line.y,
+                    text_width,
+                    &crate::ui::truncate_end(&text_at(tokens, 0), text_width as usize),
+                    background.fg(palette.subtext0).add_modifier(Modifier::BOLD),
+                );
+                if available > badge_width + 2 {
