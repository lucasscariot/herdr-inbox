diff --git a/src/client/shell/inbox_keys.rs b/src/client/shell/inbox_keys.rs
new file mode 100644
index 0000000..ec29459
--- /dev/null
+++ b/src/client/shell/inbox_keys.rs
@@ -0,0 +1,737 @@
+//! Keyboard flow for inbox mode.
+//!
+//! Tab moves focus between the thread list and the terminal, j/k walk the
+//! threads, Enter opens one, Backspace archives it, and Ctrl+T dictates into
+//! the focused thread from anywhere: the recording and transcription run in
+//! the plugin's own `python3 main.py dictate` process, which also delivers the
+//! text through Herdr's prompt transport on whichever machine owns the pane.
+
+use super::*;
+use crossterm::event::KeyModifiers;
+use std::io::{BufRead, Write};
+use std::sync::mpsc;
+
+pub(super) const INBOX_PLUGIN_ID: &str = "lucasscariot.herdr-inbox";
+
+/// Test hook: the event sender and the bytes a detached session wrote to its "stdin".
+#[cfg(test)]
+pub(super) type InboxDictationProbe = (
+    mpsc::Sender<InboxDictationEvent>,
+    std::sync::Arc<std::sync::Mutex<Vec<u8>>>,
+);
+const FINISHED_NOTICE: std::time::Duration = std::time::Duration::from_secs(4);
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(super) enum InboxFocus {
+    #[default]
+    Terminal,
+    Threads,
+}
+
+/// One line printed by the dictation process, or the process ending.
+pub(super) enum InboxDictationEvent {
+    Stdin(Box<dyn Write + Send>),
+    Recording,
+    Transcribing,
+    Done { mode: String, text: String },
+    Cancelled,
+    Error(String),
+    Exited,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) enum InboxDictationPhase {
+    Starting,
+    Recording {
+        since: std::time::Instant,
+        shown_seconds: u64,
+    },
+    Finishing {
+        mode: &'static str,
+        transcribing: bool,
+    },
+    Finished {
+        message: String,
+        until: std::time::Instant,
+    },
+}
+
+pub(super) struct InboxDictation {
+    pub(super) title: String,
+    pub(super) phase: InboxDictationPhase,
+    stdin: Option<Box<dyn Write + Send>>,
+    pending_command: Option<&'static str>,
+    events: mpsc::Receiver<InboxDictationEvent>,
+    #[cfg(test)]
+    _keep_alive: Option<mpsc::Sender<InboxDictationEvent>>,
+}
+
+impl InboxDictation {
+    /// Start the plugin's dictation process for `target` and relay its events.
+    pub(super) fn spawn(target: (ClientEndpointId, String), title: String) -> Self {
+        let (sender, events) = mpsc::channel();
+        let machine = match &target.0 {
+            ClientEndpointId::Local => "local".to_owned(),
+            ClientEndpointId::Ssh(profile) => profile.as_str().to_owned(),
+        };
+        let pane_id = target.1.clone();
+        let thread_title = title.clone();
+        std::thread::spawn(move || {
+            run_dictation_process(&sender, &pane_id, &machine, &thread_title)
+        });
+        Self {
+            title,
+            phase: InboxDictationPhase::Starting,
+            stdin: None,
+            pending_command: None,
+            events,
+            #[cfg(test)]
+            _keep_alive: None,
+        }
+    }
+
+    /// A session with no process behind it; tests feed events and read commands.
+    #[cfg(test)]
+    pub(super) fn detached(
+        title: String,
+    ) -> (
+        Self,
+        mpsc::Sender<InboxDictationEvent>,
+        std::sync::Arc<std::sync::Mutex<Vec<u8>>>,
+    ) {
+        let (sender, events) = mpsc::channel();
+        let written = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+        let session = Self {
+            title,
+            phase: InboxDictationPhase::Recording {
+                since: std::time::Instant::now(),
+                shown_seconds: 0,
+            },
+            stdin: Some(Box::new(SharedWriter(written.clone()))),
+            pending_command: None,
+            events,
+            _keep_alive: Some(sender.clone()),
+        };
+        (session, sender, written)
+    }
+
+    pub(super) fn active(&self) -> bool {
+        !matches!(self.phase, InboxDictationPhase::Finished { .. })
+    }
+
+    pub(super) fn recording(&self) -> bool {
+        matches!(
+            self.phase,
+            InboxDictationPhase::Starting | InboxDictationPhase::Recording { .. }
+        )
+    }
+
+    fn command(&mut self, command: &'static str) {
+        match self.stdin.take() {
+            Some(mut stdin) => {
+                let _ = writeln!(stdin, "{command}");
+                let _ = stdin.flush();
+            }
+            None => self.pending_command = Some(command),
+        }
+    }
+}
+
+#[cfg(test)]
+struct SharedWriter(std::sync::Arc<std::sync::Mutex<Vec<u8>>>);
+
+#[cfg(test)]
+impl Write for SharedWriter {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().expect("writer lock").extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+/// Where the plugin lives: `HERDR_INBOX_ROOT`, or the server's plugin registry.
+fn inbox_plugin_root() -> Result<std::path::PathBuf, String> {
+    if let Some(root) = std::env::var_os("HERDR_INBOX_ROOT") {
+        return Ok(std::path::PathBuf::from(root));
+    }
+    let herdr = crate::platform::launch_executable().map_err(|err| err.to_string())?;
+    let output = std::process::Command::new(herdr)
+        .args(["plugin", "list", "--json"])
+        .stdin(std::process::Stdio::null())
+        .output()
+        .map_err(|err| format!("could not list plugins: {err}"))?;
+    let listing: serde_json::Value = serde_json::from_slice(&output.stdout)
+        .map_err(|_| "could not read the plugin list".to_owned())?;
+    listing["result"]["plugins"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .find(|plugin| plugin["plugin_id"] == INBOX_PLUGIN_ID)
+        .and_then(|plugin| plugin["plugin_root"].as_str())
+        .map(std::path::PathBuf::from)
+        .ok_or_else(|| {
+            "Herdr Inbox is not installed here; run: herdr plugin install lucasscariot/herdr-inbox"
+                .to_owned()
+        })
+}
+
+fn run_dictation_process(
+    sender: &mpsc::Sender<InboxDictationEvent>,
+    pane_id: &str,
+    machine: &str,
+    title: &str,
+) {
+    let root = match inbox_plugin_root() {
+        Ok(root) => root,
+        Err(message) => {
+            let _ = sender.send(InboxDictationEvent::Error(message));
+            let _ = sender.send(InboxDictationEvent::Exited);
+            return;
+        }
+    };
+    let mut command = std::process::Command::new("python3");
+    command
+        .args([
+            "main.py",
+            "dictate",
+            "--pane",
+            pane_id,
+            "--machine",
+            machine,
+        ])
+        .arg("--title")
+        .arg(title)
+        .current_dir(&root)
+        .env("HERDR_ENV", "1")
+        .env("HERDR_SOCKET_PATH", crate::api::socket_path())
+        .env("HERDR_PLUGIN_ROOT", &root)
+        .env(
+            "HERDR_PLUGIN_CONFIG_DIR",
+            crate::plugin_paths::plugin_config_dir(INBOX_PLUGIN_ID),
+        )
+        .env(
+            "HERDR_PLUGIN_STATE_DIR",
+            crate::plugin_paths::plugin_state_dir(INBOX_PLUGIN_ID),
+        )
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped());
+    if let Ok(herdr) = crate::platform::launch_executable() {
+        command.env("HERDR_BIN_PATH", herdr);
+    }
+    let mut child = match command.spawn() {
+        Ok(child) => child,
+        Err(err) => {
+            let _ = sender.send(InboxDictationEvent::Error(format!(
+                "could not start python3 for dictation: {err}"
+            )));
+            let _ = sender.send(InboxDictationEvent::Exited);
+            return;
+        }
+    };
+    if let Some(stdin) = child.stdin.take() {
+        let _ = sender.send(InboxDictationEvent::Stdin(Box::new(stdin)));
+    }
+    let stderr = child.stderr.take();
+    let mut reported = false;
+    if let Some(stdout) = child.stdout.take() {
+        for line in std::io::BufReader::new(stdout).lines() {
+            let Ok(line) = line else { break };
+            let Ok(value) = serde_json::from_str::<serde_json::Value>(&line) else {
+                continue;
+            };
+            let event = match value["event"].as_str().unwrap_or_default() {
+                "recording" => InboxDictationEvent::Recording,
+                "transcribing" => InboxDictationEvent::Transcribing,
+                "done" => InboxDictationEvent::Done {
+                    mode: value["mode"].as_str().unwrap_or("send").to_owned(),
+                    text: value["text"].as_str().unwrap_or_default().to_owned(),
+                },
+                "cancelled" => InboxDictationEvent::Cancelled,
+                "error" => InboxDictationEvent::Error(
+                    value["message"]
+                        .as_str()
+                        .unwrap_or("dictation failed")
+                        .to_owned(),
+                ),
+                _ => continue,
+            };
+            reported |= matches!(
+                event,
+                InboxDictationEvent::Done { .. }
+                    | InboxDictationEvent::Cancelled
+                    | InboxDictationEvent::Error(_)
+            );
+            if sender.send(event).is_err() {
+                break;
+            }
+        }
+    }
+    let status = child.wait();
+    if !reported && !status.as_ref().is_ok_and(|status| status.success()) {
+        let detail = stderr
+            .and_then(|mut stderr| {
+                let mut text = String::new();
+                std::io::Read::read_to_string(&mut stderr, &mut text).ok()?;
+                text.lines().last().map(str::to_owned)
+            })
+            .unwrap_or_default();
+        let _ = sender.send(InboxDictationEvent::Error(if detail.is_empty() {
+            "dictation ended before it reported a result".to_owned()
+        } else {
+            format!("dictation failed: {detail}")
+        }));
+    }
+    let _ = sender.send(InboxDictationEvent::Exited);
+}
