+/// Inbox mode groups the priority-sorted list under one heading per status run.
+pub(super) fn assign_inbox_sections<'a>(
+    rows: impl IntoIterator<Item = &'a mut AgentRow>,
+    config: &ClientShellConfig,
+) {
+    if !config.inbox_mode
+        || config.agent_panel_sort != crate::config::AgentPanelSortConfig::Priority
+    {
+        return;
+    }
+    let mut rows = rows.into_iter().collect::<Vec<_>>();
+    let mut index = 0;
+    while index < rows.len() {
+        let status = rows[index].status;
+        let run = rows[index..]
+            .iter()
+            .take_while(|row| row.status == status)
+            .count();
+        rows[index].section = Some((inbox_section_label(status), run));
+        index += run.max(1);
+    }
+}
