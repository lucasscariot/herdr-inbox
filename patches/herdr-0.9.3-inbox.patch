+    // Run the composer on Local, where the user's saved fleet profiles live,
+    // even while the client is presenting a remote agent terminal.
+    pub(super) fn open_inbox_action(&mut self, action: &str, outcome: &mut ClientShellInput) {
+        let labels = self.inbox_binding_labels(action);
+        let snapshot = if self.active_endpoint_id.is_local() {
+            self.snapshot.as_deref()
+        } else {
+            self.endpoints
+                .iter()
+                .find(|endpoint| endpoint.endpoint_id.is_local())
+                .and_then(|endpoint| endpoint.snapshot.as_deref())
+        };
+        let Some(snapshot) = snapshot else {
+            return;
+        };
+        let Some(command) = snapshot.commands.iter().find(|command| {
+            command.action == crate::protocol::ClientShellCommandAction::PluginAction
+                && !labels.is_empty()
+                && labels
+                    .iter()
+                    .all(|label| command.binding_labels.contains(label))
+        }) else {
+            self.set_endpoint_error(
+                "inbox launcher is not configured on Local; reload configuration",
+            );
+            outcome.repaint = true;
+            return;
+        };
+        // The TUI transport supports command.invoke, not the public API's
+        // plugin.action.invoke. Resolve the server's opaque command ID.
+        let boot_id = snapshot.boot_id.clone();
+        let method =
+            crate::api::schema::Method::CommandInvoke(crate::api::schema::CommandInvokeParams {
+                command_id: command.command_id.clone(),
+                workspace_id: snapshot.focused_workspace_id.clone(),
+                tab_id: snapshot.focused_tab_id.clone(),
+                pane_id: snapshot.focused_pane_id.clone(),
+                selection: None,
+            });
+        let label = if action == "new" {
+            "New thread"
+        } else {
+            "Agent inbox"
+        }
+        .to_string();
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(15);
+        if self.active_endpoint_id.is_local() {
+            self.pending_inbox_focus = Some((label, boot_id, deadline));
+            self.push_endpoint_method(method, outcome);
+            return;
+        }
+        self.activate_endpoint(ClientEndpointId::Local, outcome);
+        self.pending_inbox_focus = Some((label, boot_id.clone(), deadline));
+        let request_id = format!("client-shell:{}", self.next_request_id);
+        self.next_request_id = self.next_request_id.saturating_add(1);
+        self.pending_requests.insert(
+            request_id.clone(),
+            PendingEndpointRequest {
+                boot_id: boot_id.clone(),
+                method_name: "command.invoke".into(),
+                confirmation_workspace_id: None,
+                kind: PendingEndpointKind::Generic,
+            },
+        );
+        outcome.actions.push(ClientShellAction::Endpoint {
+            endpoint_id: ClientEndpointId::Local,
+            boot_id,
+            request: Box::new(crate::api::schema::Request {
+                id: request_id,
+                method,
+            }),
+        });
+    }
+
+    pub(crate) fn tick_inbox_focus(&mut self, now: std::time::Instant) -> ClientShellInput {
+        let mut outcome = ClientShellInput::default();
+        let Some((label, boot_id, deadline)) = self.pending_inbox_focus.as_ref() else {
+            return outcome;
+        };
+        if now >= *deadline {
+            self.pending_inbox_focus = None;
+            return outcome;
+        }
+        if !self.active_endpoint_id.is_local() {
+            return outcome;
+        }
+        if self
+            .snapshot
+            .as_deref()
+            .is_some_and(|snapshot| &snapshot.boot_id != boot_id)
+        {
+            self.pending_inbox_focus = None;
+            return outcome;
+        }
+        // Plugin actions create/focus their pane through the public API. That
+        // changes server focus, while each attached client owns its own focus.
+        // Complete this client's explicit New-thread request over its TUI channel.
+        let pane_id = self.snapshot.as_deref().and_then(|snapshot| {
+            snapshot
+                .panes
+                .iter()
+                .rev()
+                .find(|pane| pane.label.as_ref() == Some(label))
+                .map(|pane| pane.pane_id.clone())
+        });
+        if let Some(pane_id) = pane_id {
+            self.pending_inbox_focus = None;
+            self.push_endpoint_method(
+                crate::api::schema::Method::PaneFocus(crate::api::schema::PaneTarget { pane_id }),
+                &mut outcome,
+            );
+        }
+        outcome
+    }
