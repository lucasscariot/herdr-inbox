+/// What the mode bar shows for the inbox: a badge plus hint segments; `true` marks a key.
+pub(super) struct InboxStatus {
+    pub(super) badge: String,
+    pub(super) segments: Vec<(String, bool)>,
+}
+
+impl ClientShellState {
+    /// Threads in sidebar order, across machines when more than one is attached.
+    pub(super) fn inbox_targets(&self) -> Vec<(ClientEndpointId, String)> {
+        if self.multi_endpoint_active() {
+            return super::aggregate_navigation::online_agent_targets(
+                &self.endpoints,
+                &self.active_endpoint_id,
+                self.config.agent_panel_sort,
+            )
+            .into_iter()
+            .map(|target| (target.endpoint_id, target.pane_id))
+            .collect();
+        }
+        self.snapshot
+            .as_deref()
+            .map(|snapshot| {
+                super::agent_sidebar::ordered_agent_pane_ids(snapshot, self.config.agent_panel_sort)
+                    .into_iter()
+                    .map(|pane_id| (self.active_endpoint_id.clone(), pane_id))
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    /// The focused pane when it is an agent thread; plugin panes keep their own keys.
+    pub(super) fn focused_inbox_thread(&self) -> Option<(ClientEndpointId, String)> {
+        let snapshot = self.snapshot.as_deref()?;
+        let pane_id = snapshot.focused_pane_id.clone()?;
+        snapshot
+            .agents
+            .iter()
+            .any(|agent| agent.pane_id == pane_id)
+            .then(|| (self.active_endpoint_id.clone(), pane_id))
+    }
+
+    fn inbox_thread_title(&self, target: &(ClientEndpointId, String)) -> String {
+        let snapshot = if target.0 == self.active_endpoint_id {
+            self.snapshot.as_deref()
+        } else {
+            self.endpoints
+                .iter()
+                .find(|endpoint| endpoint.endpoint_id == target.0)
+                .and_then(|endpoint| endpoint.snapshot.as_deref())
+        };
+        snapshot
+            .and_then(|snapshot| {
+                snapshot
+                    .agents
+                    .iter()
+                    .find(|agent| agent.pane_id == target.1)
+            })
+            .map(|agent| super::agent_sidebar::inbox_thread_title(agent, None))
+            .unwrap_or_else(|| target.1.clone())
+    }
+
+    /// Handles a key in terminal mode. Returns true when the inbox consumed it.
+    pub(super) fn route_inbox_key(
+        &mut self,
+        key: &crate::input::TerminalKey,
+        outcome: &mut ClientShellInput,
+    ) -> bool {
+        if !self.config.inbox_mode {
+            return false;
+        }
+        let (code, modifiers) = crate::config::normalize_key_combo((key.code, key.modifiers));
+        let plain = modifiers.is_empty();
+        let ctrl_t = crate::config::terminal_key_matches_combo(
+            key,
+            (KeyCode::Char('t'), KeyModifiers::CONTROL),
+        );
+        if self
+            .inbox_dictation
+            .as_ref()
+            .is_some_and(InboxDictation::recording)
+        {
+            let command = if plain && code == KeyCode::Enter {
+                Some("send")
+            } else if ctrl_t {
+                Some("type")
+            } else if plain && code == KeyCode::Esc {
+                Some("cancel")
+            } else {
+                None
+            };
+            if let Some(command) = command {
+                self.finish_inbox_dictation(command);
+                outcome.repaint = true;
+                return true;
+            }
+        }
+        if ctrl_t {
+            let target = (self.inbox_focus == InboxFocus::Threads)
+                .then(|| self.inbox_cursor.clone())
+                .flatten()
+                .or_else(|| self.focused_inbox_thread());
+            let Some(target) = target else {
+                return false;
+            };
+            self.begin_inbox_dictation(target, outcome);
+            return true;
+        }
+        match self.inbox_focus {
+            InboxFocus::Terminal => {
+                if plain && code == KeyCode::Tab && self.focused_inbox_thread().is_some() {
+                    self.enter_inbox_threads(outcome);
+                    return true;
+                }
+                false
+            }
+            InboxFocus::Threads => {
+                let shift = modifiers == KeyModifiers::SHIFT;
+                match code {
+                    KeyCode::Tab | KeyCode::Esc if plain => self.leave_inbox_threads(outcome),
+                    KeyCode::Char('j') | KeyCode::Down if plain => {
+                        self.move_inbox_cursor(1, outcome)
+                    }
+                    KeyCode::Char('k') | KeyCode::Up if plain => {
+                        self.move_inbox_cursor(-1, outcome)
+                    }
+                    KeyCode::Char('g') | KeyCode::Home if plain => {
+                        self.move_inbox_cursor(isize::MIN, outcome)
+                    }
+                    KeyCode::Char('G') | KeyCode::End if plain || shift => {
+                        self.move_inbox_cursor(isize::MAX, outcome)
+                    }
+                    KeyCode::Enter | KeyCode::Char('o') if plain => self.open_inbox_cursor(outcome),
+                    KeyCode::Backspace | KeyCode::Delete | KeyCode::Char('x') if plain => {
+                        self.archive_inbox_cursor(outcome)
+                    }
+                    _ => {}
+                }
+                // Nothing typed while the list has focus reaches the agent.
+                true
+            }
+        }
+    }
+
+    fn enter_inbox_threads(&mut self, outcome: &mut ClientShellInput) {
+        let targets = self.inbox_targets();
+        let cursor = self
+            .focused_inbox_thread()
+            .filter(|focused| targets.contains(focused))
+            .or_else(|| {
+                self.inbox_cursor
+                    .clone()
+                    .filter(|cursor| targets.contains(cursor))
+            })
+            .or_else(|| targets.first().cloned());
+        self.inbox_focus = InboxFocus::Threads;
+        self.inbox_cursor = cursor;
+        self.reveal_inbox_cursor();
+        outcome.repaint = true;
+    }
+
+    fn leave_inbox_threads(&mut self, outcome: &mut ClientShellInput) {
+        self.inbox_focus = InboxFocus::Terminal;
+        outcome.repaint = true;
+    }
+
+    /// A click on a thread row behaves like opening it from the keyboard.
+    pub(super) fn note_inbox_thread_click(&mut self, target: (ClientEndpointId, String)) {
+        if !self.config.inbox_mode {
+            return;
+        }
+        self.inbox_cursor = Some(target);
+        self.inbox_focus = InboxFocus::Terminal;
+    }
+
+    fn move_inbox_cursor(&mut self, delta: isize, outcome: &mut ClientShellInput) {
+        let targets = self.inbox_targets();
+        if targets.is_empty() {
+            self.inbox_cursor = None;
+            return;
+        }
+        let current = self
+            .inbox_cursor
+            .as_ref()
+            .and_then(|cursor| targets.iter().position(|target| target == cursor));
+        let last = targets.len() - 1;
+        let next = match (current, delta) {
+            (_, isize::MIN) => 0,
+            (_, isize::MAX) => last,
+            (Some(index), delta) => index.saturating_add_signed(delta).min(last),
+            (None, delta) if delta < 0 => last,
+            (None, _) => 0,
+        };
+        self.inbox_cursor = Some(targets[next].clone());
+        self.reveal_inbox_cursor();
+        outcome.repaint = true;
+    }
+
+    fn reveal_inbox_cursor(&mut self) {
+        let Some((endpoint_id, pane_id)) = self.inbox_cursor.clone() else {
+            return;
+        };
+        let height = self.hits.agent_body.height;
+        self.reveal_endpoint_agent(&endpoint_id, &pane_id, height);
+    }
+
+    fn open_inbox_cursor(&mut self, outcome: &mut ClientShellInput) {
+        let Some((endpoint_id, pane_id)) = self.inbox_cursor.clone() else {
+            return;
+        };
+        self.inbox_focus = InboxFocus::Terminal;
+        self.focus_or_activate(
+            endpoint_id,
+            ClientEndpointFocusTarget::Pane(pane_id),
+            outcome,
+        );
+        outcome.repaint = true;
+    }
+
+    fn archive_inbox_cursor(&mut self, outcome: &mut ClientShellInput) {
+        let Some((endpoint_id, pane_id)) = self.inbox_cursor.clone() else {
+            return;
+        };
+        // Land on the neighbour below, or above when archiving the last row.
+        let targets = self.inbox_targets();
+        if let Some(index) = targets
+            .iter()
+            .position(|target| target == &(endpoint_id.clone(), pane_id.clone()))
+        {
+            self.inbox_cursor = targets
+                .get(index + 1)
+                .or_else(|| {
+                    index
+                        .checked_sub(1)
+                        .and_then(|previous| targets.get(previous))
+                })
+                .cloned();
+        }
+        self.archive_thread(endpoint_id, &pane_id, outcome);
+        outcome.repaint = true;
+    }
+
+    pub(super) fn begin_inbox_dictation(
+        &mut self,
+        target: (ClientEndpointId, String),
+        outcome: &mut ClientShellInput,
+    ) {
+        if self
+            .inbox_dictation
+            .as_ref()
+            .is_some_and(InboxDictation::active)
+        {
+            return;
+        }
+        let title = self.inbox_thread_title(&target);
+        #[cfg(test)]
+        if self.inbox_dictation_offline {
+            let (session, sender, written) = InboxDictation::detached(title);
+            self.inbox_dictation_probe = Some((sender, written));
+            self.inbox_dictation = Some(session);
+            outcome.repaint = true;
+            return;
+        }
+        self.inbox_dictation = Some(InboxDictation::spawn(target, title));
+        outcome.repaint = true;
+    }
+
+    fn finish_inbox_dictation(&mut self, command: &'static str) {
+        let Some(session) = self.inbox_dictation.as_mut() else {
+            return;
+        };
+        session.command(command);
+        session.phase = if command == "cancel" {
+            InboxDictationPhase::Finished {
+                message: "Recording discarded".to_owned(),
+                until: std::time::Instant::now() + std::time::Duration::from_millis(1500),
+            }
+        } else {
+            InboxDictationPhase::Finishing {
+                mode: command,
+                transcribing: false,
+            }
+        };
+    }
+
+    /// Drains dictation events; returns whether the frame needs repainting.
+    pub(crate) fn tick_inbox_dictation(&mut self, now: std::time::Instant) -> bool {
+        let Some(session) = self.inbox_dictation.as_mut() else {
+            return false;
+        };
+        let mut repaint = false;
+        let mut error = None;
+        loop {
+            let event = match session.events.try_recv() {
+                Ok(event) => event,
+                Err(mpsc::TryRecvError::Empty) => break,
+                Err(mpsc::TryRecvError::Disconnected) => {
+                    if session.active() {
+                        InboxDictationEvent::Exited
+                    } else {
+                        break;
+                    }
+                }
+            };
+            repaint = true;
+            match event {
+                InboxDictationEvent::Stdin(stdin) => {
+                    session.stdin = Some(stdin);
+                    if let Some(command) = session.pending_command.take() {
+                        session.command(command);
+                    }
+                }
+                InboxDictationEvent::Recording => {
+                    if session.phase == InboxDictationPhase::Starting {
+                        session.phase = InboxDictationPhase::Recording {
+                            since: now,
+                            shown_seconds: 0,
+                        };
+                    }
+                }
+                InboxDictationEvent::Transcribing => {
+                    if let InboxDictationPhase::Finishing { transcribing, .. } = &mut session.phase
+                    {
+                        *transcribing = true;
+                    }
+                }
+                InboxDictationEvent::Done { mode, text } => {
+                    let verb = if mode == "type" {
+                        "Typed into"
+                    } else {
+                        "Sent to"
+                    };
+                    session.phase = InboxDictationPhase::Finished {
+                        message: format!("{verb} {}: {text}", session.title),
+                        until: now + FINISHED_NOTICE,
+                    };
+                }
+                InboxDictationEvent::Cancelled => {
+                    session.phase = InboxDictationPhase::Finished {
+                        message: "Recording discarded".to_owned(),
+                        until: now + std::time::Duration::from_millis(1500),
+                    };
+                }
+                InboxDictationEvent::Error(message) => {
+                    error = Some(message);
+                    session.phase = InboxDictationPhase::Finished {
+                        message: String::new(),
+                        until: now,
+                    };
+                }
+                InboxDictationEvent::Exited => {
+                    if session.active() {
+                        error = Some("dictation ended before it reported a result".to_owned());
+                        session.phase = InboxDictationPhase::Finished {
+                            message: String::new(),
+                            until: now,
+                        };
+                    }
+                    if matches!(session.phase, InboxDictationPhase::Finished { .. }) {
+                        break;
+                    }
+                }
+            }
+        }
+        match &mut session.phase {
+            InboxDictationPhase::Recording {
+                since,
+                shown_seconds,
+            } => {
+                let seconds = now.saturating_duration_since(*since).as_secs();
+                if seconds != *shown_seconds {
+                    *shown_seconds = seconds;
+                    repaint = true;
+                }
+            }
+            InboxDictationPhase::Finished { until, .. } if now >= *until => {
+                self.inbox_dictation = None;
+                repaint = true;
+            }
+            _ => {}
+        }
+        if let Some(message) = error {
+            self.set_endpoint_error(format!("Dictation: {message}"));
+            repaint = true;
+        }
+        repaint
+    }
+
+    pub(super) fn inbox_status(&self) -> Option<InboxStatus> {
+        if !self.config.inbox_mode {
+            return None;
+        }
+        if let Some(session) = self.inbox_dictation.as_ref() {
+            let title = crate::ui::truncate_end(&session.title, 28);
+            return Some(match &session.phase {
+                InboxDictationPhase::Starting => InboxStatus {
+                    badge: " DICTATE ".to_owned(),
+                    segments: vec![(format!(" starting the recorder for {title}…"), false)],
+                },
+                InboxDictationPhase::Recording { shown_seconds, .. } => InboxStatus {
+                    badge: format!(" ● REC {}:{:02} ", shown_seconds / 60, shown_seconds % 60),
+                    segments: vec![
+                        (format!(" to {title}   "), false),
+                        ("enter".to_owned(), true),
+                        (" send  ".to_owned(), false),
+                        ("ctrl+t".to_owned(), true),
+                        (" type without sending  ".to_owned(), false),
+                        ("esc".to_owned(), true),
+                        (" discard".to_owned(), false),
+                    ],
+                },
+                InboxDictationPhase::Finishing { mode, transcribing } => InboxStatus {
+                    badge: " DICTATE ".to_owned(),
+                    segments: vec![(
+                        if !*transcribing {
+                            format!(" stopping the recorder for {title}…")
+                        } else if *mode == "type" {
+                            format!(" ⟳ transcribing, then typing into {title}…")
+                        } else {
+                            format!(" ⟳ transcribing, then sending to {title}…")
+                        },
+                        false,
+                    )],
+                },
+                InboxDictationPhase::Finished { message, .. } => InboxStatus {
+                    badge: " DICTATE ".to_owned(),
+                    segments: vec![(format!(" ✓ {message}"), false)],
+                },
+            });
+        }
+        (self.inbox_focus == InboxFocus::Threads).then(|| InboxStatus {
+            badge: " THREADS ".to_owned(),
+            segments: vec![
+                (" ".to_owned(), false),
+                ("j/k".to_owned(), true),
+                (" move  ".to_owned(), false),
+                ("enter".to_owned(), true),
+                (" open  ".to_owned(), false),
+                ("⌫".to_owned(), true),
+                (" archive  ".to_owned(), false),
+                ("ctrl+t".to_owned(), true),
+                (" dictate  ".to_owned(), false),
+                ("tab".to_owned(), true),
+                (" terminal".to_owned(), false),
+            ],
+        })
+    }
+}
