+#[test]
+fn inbox_pending_focus_expires_and_does_not_cross_a_server_restart() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.config.inbox_mode = true;
+    let mut initial = snapshot();
+    initial.commands.push(inbox_command());
+    state.set_snapshot(Box::new(initial.clone()));
+    let mut outcome = ClientShellInput::default();
+    state.open_inbox_action("new", &mut outcome);
+    assert!(state
+        .tick_inbox_focus(std::time::Instant::now() + std::time::Duration::from_secs(16))
+        .actions
+        .is_empty());
+    assert!(state.pending_inbox_focus.is_none());
+    state.open_inbox_action("new", &mut outcome);
+    initial.boot_id = "restarted-server".into();
+    initial.panes[0].label = Some("New thread".into());
+    state.set_snapshot(Box::new(initial));
+    assert!(state
+        .tick_inbox_focus(std::time::Instant::now())
+        .actions
+        .is_empty());
+    assert!(state.pending_inbox_focus.is_none());
+}
