+fn render_inbox_row(buffer: &mut Buffer, rect: Rect, row: &AgentRow, config: &ClientShellConfig) {
+    use crate::api::schema::AgentStatus;
+    use crate::ui::ResolvedTokenKind;
+    let palette = &config.palette;
+    let background = if row.focused {
+        Style::default().bg(palette.active_row_bg)
+    } else {
+        Style::default()
+    };
+    let status = match row.status {
+        AgentStatus::Blocked => "Input",
+        AgentStatus::Done => "Ready",
+        AgentStatus::Working => "Working",
+        AgentStatus::Idle | AgentStatus::Unknown => "Waiting",
+    };
+    for (index, tokens) in row.rows.iter().take(rect.height as usize).enumerate() {
+        let text = tokens
+            .first()
+            .map(|token| match &token.kind {
+                ResolvedTokenKind::Workspace(value)
+                | ResolvedTokenKind::TerminalTitle(value)
+                | ResolvedTokenKind::Custom(value) => value.as_str(),
+                _ => "",
+            })
+            .unwrap_or("");
+        let style = if index == 1 {
+            Style::default()
+                .fg(palette.text)
+                .add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().fg(palette.overlay0)
+        };
+        let line = Rect::new(rect.x, rect.y + index as u16, rect.width, 1);
+        Paragraph::new("").style(background).render(line, buffer);
+        let width = if index == 0 {
+            rect.width.saturating_sub(status.len() as u16 + 5)
+        } else {
+            rect.width.saturating_sub(4)
+        };
+        Paragraph::new(crate::ui::truncate_end(text, width as usize))
+            .style(background.patch(style))
+            .render(Rect::new(line.x + 2, line.y, width, 1), buffer);
+        if index == 0 && rect.width > status.len() as u16 + 4 {
+            Paragraph::new(status)
+                .style(background.fg(status_color(row.status, palette)))
+                .render(
+                    Rect::new(
+                        line.x + line.width - status.len() as u16 - 2,
+                        line.y,
+                        status.len() as u16,
+                        1,
+                    ),
+                    buffer,
+                );
+        }
+    }
+}
