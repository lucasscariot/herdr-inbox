+#[test]
+fn inbox_new_thread_from_remote_view_routes_the_picker_to_local() {
+    let (mut state, remote_id) = state_with_remote();
+    state.config.inbox_mode = true;
+    let mut local = snapshot();
+    local.commands.push(inbox_command());
+    state.set_snapshot(Box::new(local));
+    state.set_endpoint_methods(Some(vec!["command.invoke".into()]));
+    assert!(state.activate_endpoint_projection(&remote_id));
+    state.compose(120, 40).expect("inbox frame");
+    let hit = state.hits.inbox_new_thread;
+    let outcome = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: hit.x,
+        row: hit.y,
+        modifiers: KeyModifiers::NONE,
+    })]);
+    assert!(outcome.actions.iter().any(|action| matches!(action,
+        ClientShellAction::Endpoint { endpoint_id: ClientEndpointId::Local, request, .. }
+            if matches!(&request.method, crate::api::schema::Method::CommandInvoke(params) if params.command_id == "cmd_inbox_new"))));
+}
+
+fn inbox_command() -> crate::protocol::ClientShellCommand {
+    crate::protocol::ClientShellCommand {
+        command_id: "cmd_inbox_new".into(),
+        binding_label: "prefix+c".into(),
+        binding_labels: vec!["prefix+c".into()],
+        action: crate::protocol::ClientShellCommandAction::PluginAction,
+        description: Some("New agent thread".into()),
+    }
+}
