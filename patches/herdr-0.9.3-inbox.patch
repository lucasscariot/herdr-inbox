+/// The task a thread was started with, as shown on its inbox row.
+pub(super) fn inbox_thread_title(
+    agent: &crate::protocol::ClientShellAgent,
+    tab_label: Option<&str>,
+) -> String {
+    let tokens = agent.tokens.iter().cloned().collect::<HashMap<_, _>>();
+    let fallback = format!("New {} thread", agent.agent.as_deref().unwrap_or("agent"));
+    let title = tokens
+        .get("thread")
+        .map(String::as_str)
+        .or(agent.terminal_title_stripped.as_deref())
+        .or(tab_label)
+        .or(agent.title.as_deref())
+        .or(agent.name.as_deref())
+        .filter(|value| !value.trim().is_empty())
+        .unwrap_or(&fallback);
+    let title = match title
+        .strip_prefix('[')
+        .and_then(|value| value.split_once(']'))
+    {
+        Some((number, rest)) if number.chars().all(|c| c.is_ascii_digit()) => rest.trim(),
+        _ => title,
+    };
+    title.split_whitespace().collect::<Vec<_>>().join(" ")
 }
 
