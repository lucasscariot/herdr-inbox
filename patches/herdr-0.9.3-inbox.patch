 pub(super) fn display_width(text: &str) -> u16 {
     UnicodeWidthStr::width(text).min(u16::MAX as usize) as u16
 }
+
+// The inbox chrome belongs to this client; agent facts still come from each server.
+pub(super) fn render_inbox_header(
+    buffer: &mut Buffer,
+    area: Rect,
+    config: &ClientShellConfig,
+    hits: &mut ShellHitMap,
+) -> Rect {
+    let palette = &config.palette;
+    // A filled, full-width button one row below the top edge, with a key hint.
+    let button = Rect::new(
+        area.x + 1,
+        area.y.saturating_add(1),
+        area.width.saturating_sub(3),
+        u16::from(area.height > 1),
+    );
+    hits.inbox_new_thread = button;
+    if !button.is_empty() {
+        let surface = Style::default().bg(palette.surface0);
+        buffer.set_style(button, surface);
+        let label = "+  New thread";
+        put_text(
+            buffer,
+            button.x + 1,
+            button.y,
+            button.width.saturating_sub(2),
+            label,
+            surface.fg(palette.accent).add_modifier(Modifier::BOLD),
+        );
+        let hint = inbox_new_thread_hint(config);
+        let hint_width = display_width(&hint);
+        if button.width > display_width(label) + hint_width + 4 {
+            put_text(
+                buffer,
+                button.right().saturating_sub(1 + hint_width),
+                button.y,
+                hint_width,
+                &hint,
+                surface.fg(palette.overlay0),
+            );
+        }
+    }
+    hits.global_launcher = Rect::new(
+        area.x + 1,
+        area.bottom().saturating_sub(1),
+        4.min(area.width.saturating_sub(2)),
+        u16::from(area.height > 0),
+    );
+    put_text(
+        buffer,
+        hits.global_launcher.x,
+        hits.global_launcher.y,
+        hits.global_launcher.width,
+        "menu",
+        Style::default().fg(palette.overlay0),
+    );
+    hits.sidebar_toggle = Rect::new(
+        area.right().saturating_sub(2),
+        area.bottom().saturating_sub(1),
+        u16::from(area.width > 1),
+        u16::from(area.height > 0),
+    );
+    put_text(
+        buffer,
+        hits.sidebar_toggle.x,
+        hits.sidebar_toggle.y,
+        hits.sidebar_toggle.width,
+        "«",
+        Style::default().fg(palette.overlay0),
+    );
+    Rect::new(
+        area.x,
+        area.y.saturating_add(3),
+        area.width.saturating_sub(1),
+        area.height.saturating_sub(4),
+    )
+}
+
+fn inbox_new_thread_hint(config: &ClientShellConfig) -> String {
+    let label = super::actions::inbox_binding_labels(config, "new")
+        .into_iter()
+        .next()
+        .unwrap_or_default();
+    match label.strip_prefix("prefix+") {
+        Some(rest) => format!("{} {rest}", config.keybinds.primary_prefix_label()),
+        None => label,
+    }
+}
