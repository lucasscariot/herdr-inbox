@@ -0,0 +1,387 @@
+use super::*;
+use crate::api::schema::AgentStatus;
+use crate::input::TerminalKey;
+use crossterm::event::KeyModifiers;
+
+fn thread(pane_id: &str, name: &str, status: AgentStatus, focused: bool) -> ClientShellAgent {
+    ClientShellAgent {
+        pane_id: pane_id.into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: Some(name.into()),
+        display_agent: None,
+        agent: Some("claude".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: status,
+        state_change_seq: 1,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused,
+    }
+}
+
+fn inbox_snapshot(focused_pane: &str) -> ClientShellSnapshot {
+    let mut local = snapshot();
+    let mut pane_2 = local.panes[0].clone();
+    pane_2.pane_id = "pane_2".into();
+    pane_2.focused = false;
+    local.panes.push(pane_2);
+    let mut composer = local.panes[0].clone();
+    composer.pane_id = "composer".into();
+    composer.label = Some("New thread".into());
+    composer.focused = false;
+    local.panes.push(composer);
+    for pane in &mut local.panes {
+        pane.focused = pane.pane_id == focused_pane;
+    }
+    local.focused_pane_id = Some(focused_pane.into());
+    local.agents.push(thread(
+        "pane_1",
+        "Fix login",
+        AgentStatus::Working,
+        focused_pane == "pane_1",
+    ));
+    local.agents.push(thread(
+        "pane_2",
+        "Add export",
+        AgentStatus::Idle,
+        focused_pane == "pane_2",
+    ));
+    local
+}
+
+fn inbox_state(focused_pane: &str) -> ClientShellState {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.config.inbox_mode = true;
+    state.config.confirm_close = false;
+    state.set_snapshot(Box::new(inbox_snapshot(focused_pane)));
+    state.set_pane_surface(surface());
+    state.set_endpoint_methods(Some(vec!["pane.focus".into(), "workspace.close".into()]));
+    state.compose(120, 40).expect("inbox frame");
+    assert_eq!(
+        state.inbox_targets(),
+        vec![
+            (ClientEndpointId::Local, "pane_1".to_owned()),
+            (ClientEndpointId::Local, "pane_2".to_owned()),
+        ]
+    );
+    state
+}
+
+fn press(state: &mut ClientShellState, code: KeyCode, modifiers: KeyModifiers) -> ClientShellInput {
+    state.handle_raw_events(vec![RawInputEvent::Key(TerminalKey::new(code, modifiers))])
+}
+
+fn cursor(state: &ClientShellState) -> Option<&str> {
+    state
+        .inbox_cursor
+        .as_ref()
+        .map(|(_, pane_id)| pane_id.as_str())
+}
+
+fn pane_input_for(outcome: &ClientShellInput, pane: &str) -> bool {
+    outcome.requests.iter().any(|request| {
+        matches!(request, ClientMessage::ClientShellPaneInput { pane_id, .. } if pane_id == pane)
+    })
+}
+
+fn ctrl_t(state: &mut ClientShellState) -> ClientShellInput {
+    press(state, KeyCode::Char('t'), KeyModifiers::CONTROL)
+}
+
+#[test]
+fn tab_focuses_the_thread_list_on_the_open_thread_and_j_k_walk_it() {
+    let mut state = inbox_state("pane_1");
+    let outcome = press(&mut state, KeyCode::Tab, KeyModifiers::NONE);
+    assert_eq!(
+        state.inbox_focus,
+        super::super::inbox_keys::InboxFocus::Threads
+    );
+    assert_eq!(cursor(&state), Some("pane_1"));
+    assert!(outcome.requests.is_empty(), "tab must not reach the agent");
+    press(&mut state, KeyCode::Char('j'), KeyModifiers::NONE);
+    assert_eq!(cursor(&state), Some("pane_2"));
+    press(&mut state, KeyCode::Char('j'), KeyModifiers::NONE);
+    assert_eq!(
+        cursor(&state),
+        Some("pane_2"),
+        "the cursor stops at the last thread"
+    );
+    press(&mut state, KeyCode::Char('k'), KeyModifiers::NONE);
+    assert_eq!(cursor(&state), Some("pane_1"));
+    press(&mut state, KeyCode::Char('G'), KeyModifiers::SHIFT);
+    assert_eq!(cursor(&state), Some("pane_2"));
+    press(&mut state, KeyCode::Char('g'), KeyModifiers::NONE);
+    assert_eq!(cursor(&state), Some("pane_1"));
+    press(&mut state, KeyCode::Down, KeyModifiers::NONE);
+    assert_eq!(cursor(&state), Some("pane_2"));
+    press(&mut state, KeyCode::Up, KeyModifiers::NONE);
+    assert_eq!(cursor(&state), Some("pane_1"));
+    assert!(state
+        .inbox_status()
+        .is_some_and(|status| status.badge.contains("THREADS")));
+    press(&mut state, KeyCode::Tab, KeyModifiers::NONE);
+    assert_eq!(
+        state.inbox_focus,
+        super::super::inbox_keys::InboxFocus::Terminal
+    );
+    assert!(state.inbox_status().is_none());
+}
+
+#[test]
+fn enter_opens_the_cursor_thread_and_hands_focus_back_to_the_terminal() {
+    let mut state = inbox_state("pane_1");
+    press(&mut state, KeyCode::Tab, KeyModifiers::NONE);
+    press(&mut state, KeyCode::Char('j'), KeyModifiers::NONE);
+    let outcome = press(&mut state, KeyCode::Enter, KeyModifiers::NONE);
+    assert!(outcome.actions.iter().any(|action| matches!(action,
+        ClientShellAction::Endpoint { request, .. }
+            if matches!(&request.method, crate::api::schema::Method::PaneFocus(params) if params.pane_id == "pane_2"))));
+    assert_eq!(
+        state.inbox_focus,
+        super::super::inbox_keys::InboxFocus::Terminal
+    );
+    assert_eq!(cursor(&state), Some("pane_2"));
+}
+
+#[test]
+fn backspace_archives_the_cursor_thread_and_moves_to_its_neighbour() {
+    let mut state = inbox_state("pane_1");
+    press(&mut state, KeyCode::Tab, KeyModifiers::NONE);
+    let outcome = press(&mut state, KeyCode::Backspace, KeyModifiers::NONE);
+    assert!(outcome.actions.iter().any(|action| matches!(action,
+        ClientShellAction::Endpoint { request, .. }
+            if matches!(&request.method, crate::api::schema::Method::WorkspaceClose(params) if params.workspace_id == "ws_1" && !params.close_group))));
+    assert_eq!(cursor(&state), Some("pane_2"));
+    assert_eq!(
+        state.inbox_focus,
+        super::super::inbox_keys::InboxFocus::Threads
+    );
+}
+
+#[test]
+fn typing_in_the_thread_list_never_reaches_the_agent_and_esc_returns() {
+    let mut state = inbox_state("pane_1");
+    press(&mut state, KeyCode::Tab, KeyModifiers::NONE);
+    let outcome = press(&mut state, KeyCode::Char('a'), KeyModifiers::NONE);
+    assert!(outcome.requests.is_empty());
+    let outcome = press(&mut state, KeyCode::Esc, KeyModifiers::NONE);
+    assert!(outcome.requests.is_empty());
+    assert_eq!(
+        state.inbox_focus,
+        super::super::inbox_keys::InboxFocus::Terminal
+    );
+    let outcome = press(&mut state, KeyCode::Char('a'), KeyModifiers::NONE);
+    assert!(pane_input_for(&outcome, "pane_1"));
+}
+
+#[test]
+fn tab_and_ctrl_t_stay_with_a_plugin_pane_such_as_the_composer() {
+    let mut state = inbox_state("composer");
+    let outcome = press(&mut state, KeyCode::Tab, KeyModifiers::NONE);
+    assert!(pane_input_for(&outcome, "composer"));
+    assert_eq!(
+        state.inbox_focus,
+        super::super::inbox_keys::InboxFocus::Terminal
+    );
+    let outcome = ctrl_t(&mut state);
+    assert!(pane_input_for(&outcome, "composer"));
+    assert!(state.inbox_dictation.is_none());
+}
+
+#[test]
+fn shift_tab_is_never_intercepted() {
+    let mut state = inbox_state("pane_1");
+    let outcome = press(&mut state, KeyCode::BackTab, KeyModifiers::NONE);
+    assert!(pane_input_for(&outcome, "pane_1"));
+    assert_eq!(
+        state.inbox_focus,
+        super::super::inbox_keys::InboxFocus::Terminal
+    );
+}
+
+#[test]
+fn ctrl_t_dictates_into_the_focused_thread_and_enter_sends() {
+    use super::super::inbox_keys::{InboxDictationEvent, InboxDictationPhase};
+    let mut state = inbox_state("pane_1");
+    state.inbox_dictation_offline = true;
+    let outcome = ctrl_t(&mut state);
+    assert!(
+        outcome.requests.is_empty(),
+        "ctrl+t is the inbox's, not the agent's"
+    );
+    assert_eq!(
+        state
+            .inbox_dictation
+            .as_ref()
+            .map(|session| session.title.as_str()),
+        Some("Fix login")
+    );
+    assert!(state
+        .inbox_status()
+        .is_some_and(|status| status.badge.contains("REC")));
+    let outcome = press(&mut state, KeyCode::Enter, KeyModifiers::NONE);
+    assert!(
+        outcome.requests.is_empty(),
+        "enter stops the recording instead of reaching the agent"
+    );
+    let (events, written) = state.inbox_dictation_probe.clone().expect("probe");
+    assert_eq!(written.lock().expect("lock").as_slice(), b"send\n");
+    assert!(matches!(
+        state.inbox_dictation.as_ref().map(|session| &session.phase),
+        Some(InboxDictationPhase::Finishing { mode: "send", .. })
+    ));
+    events
+        .send(InboxDictationEvent::Transcribing)
+        .expect("send");
+    let now = std::time::Instant::now();
+    assert!(state.tick_inbox_dictation(now));
+    assert!(state
+        .inbox_status()
+        .is_some_and(|status| status.segments[0].0.contains("transcribing")));
+    events
+        .send(InboxDictationEvent::Done {
+            mode: "send".into(),
+            text: "fix the redirect".into(),
+        })
+        .expect("send");
+    assert!(state.tick_inbox_dictation(now));
+    assert!(matches!(
+        state.inbox_dictation.as_ref().map(|session| &session.phase),
+        Some(InboxDictationPhase::Finished { message, .. }) if message == "Sent to Fix login: fix the redirect"
+    ));
+    // The agent gets keys again while the notice is up, and the notice expires on its own.
+    let outcome = press(&mut state, KeyCode::Char('a'), KeyModifiers::NONE);
+    assert!(pane_input_for(&outcome, "pane_1"));
+    assert!(state.tick_inbox_dictation(now + std::time::Duration::from_secs(5)));
+    assert!(state.inbox_dictation.is_none());
+}
+
+#[test]
+fn ctrl_t_again_types_without_sending_and_esc_discards() {
+    use super::super::inbox_keys::InboxDictationPhase;
+    let mut state = inbox_state("pane_1");
+    state.inbox_dictation_offline = true;
+    ctrl_t(&mut state);
+    ctrl_t(&mut state);
+    let (_, written) = state.inbox_dictation_probe.clone().expect("probe");
+    assert_eq!(written.lock().expect("lock").as_slice(), b"type\n");
+    assert!(matches!(
+        state.inbox_dictation.as_ref().map(|session| &session.phase),
+        Some(InboxDictationPhase::Finishing { mode: "type", .. })
+    ));
+    state.tick_inbox_dictation(std::time::Instant::now() + std::time::Duration::from_secs(60));
+    assert!(
+        state.inbox_dictation.is_some(),
+        "a finishing session waits for its result"
+    );
+
+    let mut state = inbox_state("pane_1");
+    state.inbox_dictation_offline = true;
+    ctrl_t(&mut state);
+    let outcome = press(&mut state, KeyCode::Esc, KeyModifiers::NONE);
+    assert!(outcome.requests.is_empty());
+    let (_, written) = state.inbox_dictation_probe.clone().expect("probe");
+    assert_eq!(written.lock().expect("lock").as_slice(), b"cancel\n");
+    assert!(matches!(
+        state.inbox_dictation.as_ref().map(|session| &session.phase),
+        Some(InboxDictationPhase::Finished { message, .. }) if message == "Recording discarded"
+    ));
+}
+
+#[test]
+fn ctrl_t_in_the_thread_list_targets_the_cursor_thread() {
+    let mut state = inbox_state("pane_1");
+    state.inbox_dictation_offline = true;
+    press(&mut state, KeyCode::Tab, KeyModifiers::NONE);
+    press(&mut state, KeyCode::Char('j'), KeyModifiers::NONE);
+    ctrl_t(&mut state);
+    assert_eq!(
+        state
+            .inbox_dictation
+            .as_ref()
+            .map(|session| session.title.as_str()),
+        Some("Add export")
+    );
+}
+
+#[test]
+fn dictation_errors_surface_in_the_mode_bar_error_slot() {
+    use super::super::inbox_keys::InboxDictationEvent;
+    let mut state = inbox_state("pane_1");
+    state.inbox_dictation_offline = true;
+    ctrl_t(&mut state);
+    let (events, _) = state.inbox_dictation_probe.clone().expect("probe");
+    events
+        .send(InboxDictationEvent::Error(
+            "No transcription service is connected".into(),
+        ))
+        .expect("send");
+    events.send(InboxDictationEvent::Exited).expect("send");
+    let now = std::time::Instant::now();
+    assert!(state.tick_inbox_dictation(now));
+    assert!(state
+        .endpoint_error
+        .as_deref()
+        .is_some_and(|error| error.contains("No transcription service")));
+    state.tick_inbox_dictation(now);
+    assert!(state.inbox_dictation.is_none());
+}
+
+#[test]
+fn clicking_a_thread_leaves_the_list_focused_state_behind() {
+    let mut state = inbox_state("pane_1");
+    press(&mut state, KeyCode::Tab, KeyModifiers::NONE);
+    let (rect, pane_id) = state.hits.agents[1].clone();
+    assert_eq!(pane_id, "pane_2");
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: rect.x,
+        row: rect.y,
+        modifiers: KeyModifiers::NONE,
+    })]);
+    assert_eq!(
+        state.inbox_focus,
+        super::super::inbox_keys::InboxFocus::Terminal
+    );
+    assert_eq!(cursor(&state), Some("pane_2"));
+}
+
+fn rail_background(frame: &crate::protocol::FrameData, width: usize, text: &str) -> u32 {
+    let rows = frame.cells.chunks(width).collect::<Vec<_>>();
+    let row = rows
+        .iter()
+        .find(|row| {
+            row.iter()
+                .map(|cell| cell.symbol.as_str())
+                .collect::<String>()
+                .contains(text)
+        })
+        .unwrap_or_else(|| panic!("no row shows {text}"));
+    row.iter()
+        .find(|cell| cell.symbol == "▎")
+        .map(|cell| cell.bg)
+        .expect("the thread row has a rail")
+}
+
+#[test]
+fn the_highlight_follows_the_cursor_while_the_list_has_focus() {
+    let mut state = inbox_state("pane_1");
+    let frame = state.compose(120, 40).expect("frame");
+    let open = rail_background(&frame, 120, "Fix login");
+    let other = rail_background(&frame, 120, "Add export");
+    assert_ne!(open, other, "the open thread is highlighted");
+    press(&mut state, KeyCode::Tab, KeyModifiers::NONE);
+    press(&mut state, KeyCode::Char('j'), KeyModifiers::NONE);
+    let frame = state.compose(120, 40).expect("frame");
+    assert_eq!(rail_background(&frame, 120, "Add export"), open);
+    assert_eq!(rail_background(&frame, 120, "Fix login"), other);
+    let text = frame
+        .cells
+        .iter()
+        .map(|cell| cell.symbol.as_str())
+        .collect::<String>();
+    assert!(text.contains("THREADS"));
+}
