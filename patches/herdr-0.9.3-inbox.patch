+#[test]
+fn inbox_new_thread_follows_the_created_main_pane_once() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.config.inbox_mode = true;
+    let mut initial = snapshot();
+    initial.commands.push(inbox_command());
+    state.set_snapshot(Box::new(initial.clone()));
+    state.set_endpoint_methods(Some(vec!["command.invoke".into(), "pane.focus".into()]));
+    let mut outcome = ClientShellInput::default();
+    state.open_inbox_action("new", &mut outcome);
+    assert!(state
+        .tick_inbox_focus(std::time::Instant::now())
+        .actions
+        .is_empty());
+    let mut composer = initial.panes[0].clone();
+    composer.pane_id = "composer-pane".into();
+    composer.label = Some("New thread".into());
+    initial.panes.push(composer);
+    initial.revision += 1;
+    state.set_snapshot(Box::new(initial));
+    let focus = state.tick_inbox_focus(std::time::Instant::now());
+    assert!(focus.actions.iter().any(|action| matches!(action,
+        ClientShellAction::Endpoint { request, .. }
+        if matches!(&request.method, crate::api::schema::Method::PaneFocus(params) if params.pane_id == "composer-pane"))));
+    assert!(state
+        .tick_inbox_focus(std::time::Instant::now())
+        .actions
+        .is_empty());
+}
