+fn inbox_composer_focus_survives_the_return_from_a_remote_thread() {
+    let (mut state, remote_id) = state_with_remote();
+    state.config.inbox_mode = true;
+    let mut local = snapshot();
+    local.commands.push(inbox_command());
+    local.panes[0].label = Some("New thread".into());
+    state.set_snapshot(Box::new(local));
+    state.set_endpoint_methods(Some(vec!["command.invoke".into(), "pane.focus".into()]));
+    assert!(state.activate_endpoint_projection(&remote_id));
+    let mut outcome = ClientShellInput::default();
+    state.open_inbox_action("new", &mut outcome);
+    assert!(state
+        .tick_inbox_focus(std::time::Instant::now())
+        .actions
+        .is_empty());
+    assert!(state.pending_inbox_focus.is_some());
+    assert!(state.activate_endpoint_projection(&ClientEndpointId::Local));
+    let focus = state.tick_inbox_focus(std::time::Instant::now());
+    assert!(focus.actions.iter().any(|action| matches!(action,
+        ClientShellAction::Endpoint { endpoint_id, request, .. }
+        if endpoint_id.is_local() && matches!(&request.method, crate::api::schema::Method::PaneFocus(params) if params.pane_id == "pane_1"))));
