+#[test]
+fn inbox_mode_hides_machine_and_tab_chrome_and_keeps_cross_machine_agents() {
+    let (mut state, remote_id) = state_with_remote();
+    state.config.inbox_mode = true;
+    let mut local = snapshot();
+    local.agents.push(agent(
+        "local-worker",
+        crate::api::schema::AgentStatus::Working,
+        1,
+    ));
+    state.set_snapshot(Box::new(local));
+    let mut remote = snapshot();
+    remote.boot_id = "remote-boot".into();
+    remote.agents.push(agent(
+        "remote-worker",
+        crate::api::schema::AgentStatus::Blocked,
+        1,
+    ));
+    state.set_endpoint_snapshot(&remote_id, Box::new(remote));
+    let frame = state.compose(120, 40).expect("inbox frame");
+    assert!(state.hits.machines.is_empty());
+    assert!(state.hits.workspaces.is_empty());
+    assert!(state.hits.tabs.is_empty());
+    assert!(state.hits.sidebar_section_divider.is_empty());
+    assert!(!state.hits.inbox_new_thread.is_empty());
+    assert!(state
+        .hits
+        .endpoint_agents
+        .iter()
+        .any(|(_, id, _)| id.is_local()));
+    assert!(state
+        .hits
+        .endpoint_agents
+        .iter()
+        .any(|(_, id, _)| id == &remote_id));
+    let text = frame
+        .cells
+        .iter()
+        .map(|cell| cell.symbol.as_str())
+        .collect::<String>();
+    assert!(text.contains("+ New thread"));
+    assert!(!text.contains("machines"));
+}
