+                    }
+                }
+                let branch = text_at(tokens, 0);
+                let machine = text_at(tokens, 1);
+                let harness = text_at(tokens, 2);
+                let branch = if branch.is_empty() {
+                    String::new()
+                } else {
+                    format!("⎇ {branch}")
+                };
+                // Keep the branch whole; drop the machine, then the harness, to fit.
+                let joined = |parts: &[&str]| {
+                    parts
+                        .iter()
+                        .filter(|part| !part.is_empty())
+                        .copied()
+                        .collect::<Vec<_>>()
+                        .join(" · ")
+                };
+                let (branch, rest) = [
+                    joined(&[&machine, &harness]),
+                    joined(&[&harness]),
+                    String::new(),
+                ]
+                .into_iter()
+                .map(|rest| {
+                    if branch.is_empty() || rest.is_empty() {
+                        (branch.clone(), rest)
+                    } else {
+                        (branch.clone(), format!(" · {rest}"))
+                    }
+                })
+                .find(|(branch, rest)| {
+                    display_width(branch) + display_width(rest) <= available as usize
+                })
+                .unwrap_or_else(|| {
+                    (
+                        crate::ui::truncate_end(&branch, available as usize),
+                        String::new(),
+                    )
+                });
+                let branch_width = display_width(&branch) as u16;
+                put_text(
+                    buffer,
+                    x,
+                    line.y,
+                    branch_width,
+                    &branch,
+                    background.fg(palette.mauve),
+                );
+                put_text(
+                    buffer,
+                    x + branch_width,
+                    line.y,
+                    display_width(&rest) as u16,
+                    &rest,
+                    background.fg(palette.overlay0),
+                );
+            }
+        }
+    }
+    archive
+}
+
+pub(super) const INBOX_ARCHIVE_LABEL: &str = "archive";
+
+/// Short badge on each inbox row; matches the plugin's own inbox vocabulary.
+pub(super) fn inbox_status_label(status: crate::api::schema::AgentStatus) -> &'static str {
+    use crate::api::schema::AgentStatus;
+    match status {
+        AgentStatus::Blocked => "Input",
+        AgentStatus::Done => "Ready",
+        AgentStatus::Working => "Working",
+        AgentStatus::Idle => "Idle",
+        AgentStatus::Unknown => "Unknown",
+    }
+}
+
+fn inbox_section_label(status: crate::api::schema::AgentStatus) -> &'static str {
+    use crate::api::schema::AgentStatus;
+    match status {
+        AgentStatus::Blocked => "needs input",
+        AgentStatus::Done => "ready",
+        AgentStatus::Working => "working",
+        AgentStatus::Idle => "idle",
+        AgentStatus::Unknown => "unknown",
+    }
+}
+
+fn inbox_status_glyph(status: crate::api::schema::AgentStatus) -> &'static str {
+    use crate::api::schema::AgentStatus;
+    match status {
+        AgentStatus::Blocked => "●",
+        AgentStatus::Done => "✓",
+        AgentStatus::Working => "◐",
+        AgentStatus::Idle => "○",
+        AgentStatus::Unknown => "·",
+    }
+}
+
+// Idle threads are the quiet majority, so they take a muted tone and the
+// states that need a look (input, ready, working) carry the colour.
+pub(super) fn inbox_status_color(
+    status: crate::api::schema::AgentStatus,
+    palette: &Palette,
+) -> ratatui::style::Color {
+    use crate::api::schema::AgentStatus;
+    match status {
+        AgentStatus::Blocked => palette.red,
+        AgentStatus::Done => palette.teal,
+        AgentStatus::Working => palette.yellow,
+        AgentStatus::Idle => palette.overlay1,
+        AgentStatus::Unknown => palette.overlay0,
+    }
 }
 
