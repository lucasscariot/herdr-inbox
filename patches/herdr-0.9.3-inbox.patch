+    let color = inbox_status_color(row.status, palette);
+    let mut rect = rect;
+    if let Some((label, count)) = row.section {
+        if rect.height == 0 {
+            return None;
+        }
+        let width = rect.width.saturating_sub(3);
+        put_text(
+            buffer,
+            rect.x + 2,
+            rect.y,
+            width,
+            label,
+            Style::default().fg(color).add_modifier(Modifier::BOLD),
+        );
+        let label_width = display_width(label) as u16;
+        if width > label_width + 2 {
+            put_text(
+                buffer,
+                rect.x + 3 + label_width,
+                rect.y,
+                width - label_width - 1,
+                &count.to_string(),
+                Style::default().fg(palette.overlay0),
+            );
+        }
+        rect = Rect::new(
+            rect.x,
+            rect.y + 1,
+            rect.width,
+            rect.height.saturating_sub(1),
