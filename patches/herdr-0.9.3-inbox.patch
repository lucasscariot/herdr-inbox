+    let outcome = state.handle_raw_events(vec![RawInputEvent::Key(
+        crate::input::TerminalKey::new(KeyCode::Enter, KeyModifiers::NONE),
+    )]);
+    assert!(state.overlay.is_none());
+    assert!(outcome.actions.iter().any(|action| matches!(action,
+        ClientShellAction::Endpoint { endpoint_id, boot_id, request }
+            if endpoint_id == &remote_id
+                && boot_id == "remote-boot"
+                && matches!(&request.method, crate::api::schema::Method::WorkspaceClose(params)
+                    if params.workspace_id == "ws_1" && !params.close_group))));
+}
+
+#[test]
+fn inbox_archive_button_closes_only_the_focused_threads_workspace() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.config.inbox_mode = true;
+    let mut local = snapshot();
+    local
+        .agents
+        .push(agent("worker", crate::api::schema::AgentStatus::Done, 1));
+    state.set_snapshot(Box::new(local));
+    state.set_pane_surface(surface());
+    state.set_endpoint_methods(Some(vec!["workspace.close".into()]));
+    state.compose(120, 40).expect("local inbox frame");
+    let (hit, _, _) = state.hits.inbox_archive[0].clone();
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: hit.x,
+        row: hit.y,
+        modifiers: KeyModifiers::NONE,
+    })]);
+    assert!(matches!(
+        &state.overlay,
+        Some(ClientShellOverlay::ConfirmClose(confirm))
+            if confirm.title == "Archive thread?" && confirm.detail.starts_with("client-shell · Local")
+    ));
+    let outcome = state.handle_raw_events(vec![RawInputEvent::Key(
+        crate::input::TerminalKey::new(KeyCode::Enter, KeyModifiers::NONE),
+    )]);
+    assert!(outcome.actions.iter().any(|action| matches!(action,
+        ClientShellAction::Endpoint { request, .. }
+            if matches!(&request.method, crate::api::schema::Method::WorkspaceClose(params)
+                if params.workspace_id == "ws_1" && !params.close_group))));
+
+    // Without close confirmation the button archives immediately.
+    state.config.confirm_close = false;
+    state.compose(120, 40).expect("local inbox frame");
+    let (hit, _, _) = state.hits.inbox_archive[0].clone();
+    let outcome = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: hit.x,
+        row: hit.y,
+        modifiers: KeyModifiers::NONE,
+    })]);
+    assert!(state.overlay.is_none());
+    assert!(outcome.actions.iter().any(|action| matches!(action,
+        ClientShellAction::Endpoint { request, .. }
+            if matches!(&request.method, crate::api::schema::Method::WorkspaceClose(_)))));
+}
